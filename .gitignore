.fontbuilder.venv
__pycache__/
.pytest_cache/
.ruff_cache/
# The user's fonts and the console's configuration (family choices, saved port) are
# local data and never committed. fonts/ itself is tracked through .gitkeep so a
# checkout, and the release tarball, has the (empty) directory the console watches.
fonts/*
!fonts/.gitkeep
font_composer.toml
font_composer.toml.tmp

# The fonts the build writes. output/ itself is tracked through .gitkeep, like fonts/.
output/*
!output/.gitkeep

# The Unicode names list (NamesList.txt) is downloaded on first use, never committed.
src/char-sets/NamesList.txt
src/char-sets/*.part

# composer web console (src/composer-web) build intermediates and compiled
# output: static/ only ever exists in a build context (local dev, the release
# bot), so it is not tracked; the server answers 503 until the SPA is built.
node_modules/
.node_modules/
.svelte-kit/
font_composer/composer/web/static/
