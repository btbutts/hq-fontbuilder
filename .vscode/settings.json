{
    "python-envs.pythonProjects": [
        {
            "path": "${workspaceFolder}",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.fontbuilder.venv/bin/python",
    "pylint.interpreter": [ "${workspaceFolder}/.fontbuilder.venv/bin/python" ],
    "typescript.tsdk": "src/composer-web/node_modules/typescript/lib",
    "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
    "files.associations": { "*.css": "tailwindcss" },
    "color-highlight.languages": [
    "*","typescript", "svelte"
    ],
    "color-highlight.markerType": "foreground",
    "editor.colorDecorators": true,
    "npm.packageManager": "bun",
    "npm.scriptRunner": "bun",
    "bun.runtime": "bun",
    "bun.debugTerminal.enabled": true,
    "bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts,cjs,mjs}",
    "bun.test.enable": true
}
